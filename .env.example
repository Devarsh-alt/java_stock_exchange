# Java Stock Exchange Simulator Environment Configuration
# Copy this file to .env or configure directly in Render Dashboard

PORT=8080
API_KEY=your_secure_api_key_here
SIMULATOR_ENABLED=true

# Database Configuration (Optional - if omitted, runs in-memory)
DB_URL=jdbc:mysql://your_mysql_host:3306/stock_exchange?useSSL=true&requireSSL=false&serverTimezone=UTC
DB_USER=exchange_user
DB_PASSWORD=your_mysql_password
